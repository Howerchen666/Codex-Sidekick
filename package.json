{
  "name": "codex-sidekick",
  "private": true,
  "description": "Stream Deck Neo companion for the OpenAI Codex extension in VS Code",
  "license": "MIT",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native-dictation.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "docs:images": "node scripts/render-docs.mjs",
    "test:host": "npm run build && node scripts/host-smoke.mjs",
    "package:vsix": "npm run build && node scripts/package-vsix.mjs",
    "package:neo": "npm run build && npm run build:native && node scripts/package-neo.mjs"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@elgato/streamdeck": "3.0.4",
    "@types/node": "22.20.1",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "ws": "8.23.0"
  }
}
